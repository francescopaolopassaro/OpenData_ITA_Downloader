<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Allow the test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenDataDownloader.Tests" />
  </ItemGroup>

  <!-- The CLI is a separate project inside src/: keep its sources out of the library. -->
  <ItemGroup>
    <Compile Remove="OpenDataDownloader.Cli\**\*.cs" />
    <Compile Remove="OpenDataDownloader.Sample\**\*.cs" />
  </ItemGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>OpenDataDownloader</PackageId>
    <Version>1.0.0</Version>
    <Authors>Passaro Francesco Paolo</Authors>
    <Description>C# library to download Italian public open data from CKAN portals (dati.gov.it, ANAC, MEF, OpenGA) and Normattiva legal-documents API.</Description>
    <PackageTags>open-data;italia;ckan;normattiva;opendata;download;gov;italy</PackageTags>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/OpenData_ITA_Downloader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/francescopaolopassaro/OpenData_ITA_Downloader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      First public release. Supports CKAN portals (package_list/package_search/package_show), Normattiva predefined collections and async search workflow, parallel atomic downloads, resource-id filename suffixes, expanded format filter (CSV/JSON/XML/SHP/GPKG/KML/TIFF/Parquet/…), manifests (JSON/CSV), and a console CLI.
    </PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile />
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.5.2" />
  </ItemGroup>

</Project>
